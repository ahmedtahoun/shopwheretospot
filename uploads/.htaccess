# Product photos only: block scripts from running in this folder.
<FilesMatch "\.(?i:php\d?|phtml|phar|pl|py|cgi|sh|asp|aspx|jsp|htaccess)$">
  Require all denied
</FilesMatch>
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .phar
<IfModule mod_php.c>
  php_flag engine off
</IfModule>

# Resized photos (uploads/thumbs) never change under the same name: browsers keep them for a year.
<IfModule mod_headers.c>
  <FilesMatch "\.webp$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header append Vary Accept
  </FilesMatch>
</IfModule>
