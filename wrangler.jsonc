// Cloudflare: the shop as the Worker "shop" (test address first, shop.wheretospot.com on switch day).
// Static files: the repo's public files, copied into dist/ by `npm run build` (filtered by .assetsignore); the Worker (worker/index.ts) answers
// everything the PHP in api/ used to answer, at the same addresses.
// Secrets (never in git) are set with `npx wrangler secret put NAME`, see docs/CLOUDFLARE-PORT.md.
{
  "name": "shop",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Runs before every `wrangler dev` and `wrangler deploy`: fills dist/ with the public files.
  "build": { "command": "node tools/build/assets.mjs", "watch_dir": "worker" },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  // The product page template is bundled as text (worker/api/pages.ts imports it).
  "rules": [{ "type": "Text", "globs": ["**/*.dc.html"], "fallthrough": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "shop", "database_id": "3a5ade1d-7866-4dc6-83cb-18299eb75244" }],
  "vars": {
    "SITE_URL": "https://shop.wheretospot.com",
    "STAGING": "1"
  }
}
