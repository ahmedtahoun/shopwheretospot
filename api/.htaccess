Options -Indexes
# Only the entry points are reachable (public, admin, image, webhooks); libraries, config and seed data are not.
<FilesMatch "^(bootstrap\.php|mailer\.php|bosta\.php|paymob\.php|customers\.php|brands\.php|seo-lib\.php|whatsapp\.php|telegram\.php|qrtool\.php|reviews\.php|reports\.php|expenses\.php|devices\.php|images\.php|sellers\.php|meta\.php|offsite\.php|alerts\.php|abandoned\.php|review-requests\.php|social\.php|bot\.php|share-page\.php|pricing\.php|orders\.php|config\.local(\.example)?\.php|seed-products\.json)$">
  Require all denied
</FilesMatch>

# Pass the Authorization header through to PHP (needed for the Bosta webhook on some servers).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>
